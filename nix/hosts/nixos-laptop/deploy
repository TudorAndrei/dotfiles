#!/usr/bin/env bash
set -euo pipefail

# Build on the management machine, then deploy to the persistent runtime host.
config_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
system_link="$HOME/.local/share/dotfiles/nixos-laptop-system"
ssh_config="$HOME/.ssh/config"
mkdir -p "$(dirname -- "$system_link")"

nix build "path:$config_dir#nixosConfigurations.nixos-laptop.config.system.build.toplevel" \
  --out-link "$system_link"
system=$(readlink -f -- "$system_link")

# Our locally built configuration is unsigned; the SSH key authenticates
# transport and the server explicitly trusts its wheel administrators.
NIX_SSHOPTS="-F $ssh_config" nix copy --no-check-sigs \
  --to ssh-ng://nixos-laptop "$system"

tar -C "$config_dir" -cf - flake.nix flake.lock configuration.nix hardware-configuration.nix deploy |
  ssh -F "$ssh_config" nixos-laptop \
    'tar -C /home/tudor/dotfiles/nix/hosts/nixos-laptop -xf -'

# This is NixOS's system generation, not a user package profile.
ssh -F "$ssh_config" nixos-laptop \
  "sudo nix-env -p /nix/var/nix/profiles/system --set '$system' && sudo '$system/bin/switch-to-configuration' switch"
