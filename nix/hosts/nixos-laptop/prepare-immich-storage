#!/usr/bin/env bash
set -euo pipefail

# Run once on nixos-laptop before deploying the Immich NixOS configuration.
if (( EUID != 0 )); then
  echo 'Run this script as root on nixos-laptop.' >&2
  exit 1
fi

volume=/dev/default/immich-data
if ! lvs default/immich-data >/dev/null 2>&1; then
  lvcreate --virtualsize 200G --thinpool default/IncusThinPool --name immich-data
  mkfs.ext4 -L immich-data "$volume"
fi

if [[ "$(blkid -s TYPE -o value "$volume")" != ext4 ]]; then
  echo "$volume exists but is not ext4. No files were changed." >&2
  exit 1
fi

echo "Immich storage is ready at $volume."
