+package stremio
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"github.com/kipsilabs/seedstrem/internal/downloader/fake"
+	"github.com/kipsilabs/seedstrem/internal/meta"
+	"github.com/kipsilabs/seedstrem/internal/metainfo"
+	"github.com/kipsilabs/seedstrem/internal/prowlarr"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestDeferredStreamKeepsDownloadCredentialsPrivate(t *testing.T) {
+	h := &Handler{}
+	res := prowlarr.Result{InfoHash: "opaque-reference", Title: "fixture", DownloadURL: "http://prowlarr:9696/download?apikey=private-secret"}
+	item := h.toStreamItem("https://example.test/access", meta.Query{}, res, 0)
+	if !strings.Contains(item.URL, "/stremio/deferred/opaque-reference?") || strings.Contains(item.URL, "private-secret") || strings.Contains(item.URL, "magnet=") {
+		t.Fatal("invalid deferred stream URL")
+	}
+	if h.deferred[res.InfoHash].result.DownloadURL != res.DownloadURL {
+		t.Fatal("download URL was not retained server-side")
+	}
+}
+
+func TestDeferredRegistryIsBoundedAndExpiredReferencesFail(t *testing.T) {
+	h := &Handler{}
+	for i := range 513 {
+		h.rememberDeferred(prowlarr.Result{InfoHash: fmt.Sprint(i)})
+	}
+	if len(h.deferred) != 512 {
+		t.Fatalf("registry size=%d", len(h.deferred))
+	}
+	h.deferred["expired"] = deferredRelease{at: time.Now().Add(-3 * time.Hour)}
+	for _, ref := range []string{"missing", "expired"} {
+		rr := httptest.NewRecorder()
+		h.Router().ServeHTTP(rr, httptest.NewRequest(http.MethodGet, "/deferred/"+ref, nil))
+		if rr.Code != http.StatusGone {
+			t.Fatalf("reference %s: status=%d", ref, rr.Code)
+		}
+	}
+}
+
+func TestStreamJSONEmitsOnlyOneDescriptionField(t *testing.T) {
+	data, err := json.Marshal(streamItem{Title: "details", Description: "details", URL: "https://example.test/video"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fields map[string]json.RawMessage
+	if err = json.Unmarshal(data, &fields); err != nil {
+		t.Fatal(err)
+	}
+	if _, exists := fields["title"]; exists {
+		t.Fatal("legacy alias duplicated the description")
+	}
+	if _, exists := fields["description"]; !exists {
+		t.Fatal("description missing")
+	}
+	var decoded streamItem
+	if err = json.Unmarshal(data, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	if decoded.Title != "details" || decoded.Description != "details" {
+		t.Fatal("description did not decode")
+	}
+}
+
+func TestDeferredSelectionUsesOriginalPlaybackPath(t *testing.T) {
+	h := newHarness(t)
+	raw := []byte("d8:announce26:http://tr.example/announce4:infod6:lengthi16e4:name11:fixture.mkvee")
+	hash, _, _, err := metainfo.FromTorrent(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.fakeDC.Put(&fake.Torrent{Hash: hash, State: "Paused", Files: []fake.File{{Name: "fixture.mkv", Size: 16}}})
+	source := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.Write(raw) }))
+	defer source.Close()
+	h.handler.rememberDeferred(prowlarr.Result{InfoHash: "reference", DownloadURL: source.URL, Title: "fixture"})
+	client := &http.Client{CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	response, err := client.Get(h.server.URL + "/stremio/deferred/reference?src=imdb&cid=tt26657236")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusFound || !strings.HasPrefix(response.Header.Get("Location"), h.server.URL+"/dl/") {
+		t.Fatalf("playback status=%d", response.StatusCode)
+	}
+	if !bytes.Equal(h.handler.torrentFiles.get(hash), raw) {
+		t.Fatal("selected raw torrent was not passed to playback")
+	}
+}
