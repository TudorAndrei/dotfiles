+// ResolveDeferred fetches only the release selected for playback.
+func (c *Client) ResolveDeferred(ctx context.Context, res Result) (Result, error) {
+	hash, name, trackers, raw, err := c.fetchTorrentHash(ctx, res.DownloadURL)
+	if err != nil {
+		return Result{}, err
+	}
+	res.InfoHash = hash
+	if res.Title == "" {
+		res.Title = name
+	}
+	res.MagnetURL = synthesizeMagnet(hash, res.Title, trackers)
+	res.TorrentFile = raw
+	res.DownloadURL = ""
+	return res, nil
+}
