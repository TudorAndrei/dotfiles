@@ -0,0 +1,65 @@
+package stremio
+
+import (
+	"github.com/go-chi/chi/v5"
+	"github.com/kipsilabs/seedstrem/internal/prowlarr"
+	"net/http"
+	"time"
+)
+
+type deferredRelease struct {
+	result prowlarr.Result
+	at     time.Time
+}
+
+// Keep private download URLs server-side in a bounded, expiring registry.
+func (h *Handler) rememberDeferred(res prowlarr.Result) {
+	h.deferredMu.Lock()
+	defer h.deferredMu.Unlock()
+	if h.deferred == nil {
+		h.deferred = make(map[string]deferredRelease)
+	}
+	for key, entry := range h.deferred {
+		if time.Since(entry.at) > 2*time.Hour {
+			delete(h.deferred, key)
+		}
+	}
+	if _, exists := h.deferred[res.InfoHash]; !exists && len(h.deferred) >= 512 {
+		var oldest string
+		var at time.Time
+		for key, entry := range h.deferred {
+			if oldest == "" || entry.at.Before(at) {
+				oldest = key
+				at = entry.at
+			}
+		}
+		delete(h.deferred, oldest)
+	}
+	h.deferred[res.InfoHash] = deferredRelease{res, time.Now()}
+}
+
+func (h *Handler) playDeferred(w http.ResponseWriter, r *http.Request) {
+	h.deferredMu.Lock()
+	entry, ok := h.deferred[chi.URLParam(r, "ref")]
+	h.deferredMu.Unlock()
+	if !ok || time.Since(entry.at) > 2*time.Hour {
+		http.Error(w, "stream reference expired; reopen the title", http.StatusGone)
+		return
+	}
+	s := h.settings()
+	resolved, err := prowlarr.New(s.Prowlarr.URL, s.Prowlarr.APIKey).ResolveDeferred(r.Context(), entry.result)
+	if err != nil {
+		http.Error(w, "failed to fetch selected torrent metadata", http.StatusBadGateway)
+		return
+	}
+	h.torrentFiles.put(resolved.InfoHash, resolved.TorrentFile)
+	// Reuse the original private-tracker/raw-torrent playback path.
+	forwarded := r.Clone(r.Context())
+	u := *r.URL
+	query := u.Query()
+	query.Set("magnet", resolved.MagnetURL)
+	u.RawQuery = query.Encode()
+	forwarded.URL = &u
+	chi.RouteContext(forwarded.Context()).URLParams.Add("infohash", resolved.InfoHash)
+	h.play(w, forwarded)
+}
