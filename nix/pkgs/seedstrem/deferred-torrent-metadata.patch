+package prowlarr
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+func TestDeferredSearchFetchesMetadataOnlyOnSelection(t *testing.T) {
+	var downloads atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/api/v1/search" {
+			fmt.Fprintf(w, `[{"title":"one","downloadUrl":"http://%s/torrent/one"},{"title":"two","downloadUrl":"http://%s/torrent/two"}]`, r.Host, r.Host)
+			return
+		}
+		downloads.Add(1)
+		w.Write([]byte("d8:announce26:http://tr.example/announce4:infod4:name4:testee"))
+	}))
+	defer srv.Close()
+	pc := NewWithClient(srv.URL, "test", srv.Client())
+	pc.DeferTorrentFiles = true
+	results, err := pc.Search(context.Background(), "test", "search", nil, nil)
+	if err != nil || len(results) != 2 {
+		t.Fatalf("discovery: count=%d error=%v", len(results), err)
+	}
+	if downloads.Load() != 0 {
+		t.Fatal("discovery downloaded torrent metadata")
+	}
+	if results[0].InfoHash == results[1].InfoHash {
+		t.Fatal("references are not distinct")
+	}
+	resolved, err := pc.ResolveDeferred(context.Background(), results[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	if downloads.Load() != 1 || len(resolved.TorrentFile) == 0 || !strings.Contains(resolved.MagnetURL, "tr=") {
+		t.Fatal("selection lost raw torrent or tracker")
+	}
+}
