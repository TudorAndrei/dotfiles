+// Stremio aliases title to description; emitting both makes strict clients
+// discard the stream as a duplicate field. Accept the legacy name on reads.
+func (item *streamItem) UnmarshalJSON(data []byte) error {
+	type wire streamItem
+	var decoded struct {
+		wire
+		LegacyTitle string `json:"title"`
+	}
+	if err := json.Unmarshal(data, &decoded); err != nil {
+		return err
+	}
+	*item = streamItem(decoded.wire)
+	if item.Description == "" {
+		item.Description = decoded.LegacyTitle
+	}
+	item.Title = item.Description
+	return nil
 }
 
