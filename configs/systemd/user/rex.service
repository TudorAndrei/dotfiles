[Unit]
Description=Rex Server
Documentation=https://www.superlogical.com/rex/docs
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/rex server run --extra-listen tailnet://:7297
Restart=on-failure
RestartSec=5s
KillMode=mixed
OOMPolicy=continue
OOMScoreAdjust=0
Delegate=yes
DelegateSubgroup=server

[Install]
WantedBy=default.target
