Include ~/.orbstack/ssh/config
Include ~/.ssh/config.local

Match originalhost nixos-laptop localnetwork 192.168.0.0/24
  HostName 192.168.0.244

Host nixos-laptop
  HostName 100.121.29.45
  User tudor
  IdentityFile ~/.ssh/nixos-laptop

Host rpi
  HostName 192.168.0.233
  User user
  IdentityFile ~/.ssh/rpi

Host *
  IdentityAgent none
  IdentitiesOnly yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  ControlMaster auto
  ControlPath ~/.ssh/cm/%C
  ControlPersist 10m
